@model BahcedenApp.Models.ViewModels.PayViewModel
@{
    ViewBag.Title = "Pay";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<div class="container">
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            @if(ViewBag.mesaj != null)
            {
                <div class="alert alert-danger">@ViewBag.mesaj</div>
            }
            @using (Html.BeginForm())
            {
               <div class="card">
                   <div class="card-header"> Ödeme İçin Kart Bilgileriniz</div>
                   <div class="card-body">
                       <div class="mt-3">
                           <label>Kart Üzerindeki İsim</label>
                           @Html.EditorFor(Model => Model.Name, new { htmlAttributes = new { @class = "form-control", @placeholder = "İsim Soyad" } })
                           @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                       </div>
                       <div class="mt-3">
                           <label>Kart Numarası</label>
                           @Html.EditorFor(Model => Model.CartNumber, new { htmlAttributes = new { @class = "form-control", @placeholder = "XXXX XXXX XXXX XXXX" } })
                           @Html.ValidationMessageFor(model => model.CartNumber, "", new { @class = "text-danger" })
                       </div>
                       <div class="mt-3">
                           <div class="input-group">
                               <span class="input-group-text">Ay</span>
                               @Html.EditorFor(Model => Model.ReqMonth, new { htmlAttributes = new { @class = "form-control", @placeholder = "00" } })
                               <span class="input-group-text">Yıl</span>
                               @Html.EditorFor(Model => Model.ReqYear, new { htmlAttributes = new { @class = "form-control", @placeholder = "00" } })
                               <span class="input-group-text">CVV</span>
                               @Html.EditorFor(Model => Model.CVV, new { htmlAttributes = new { @class = "form-control", @placeholder = "000" } })
                           </div>
                       </div>
                       <div class="mt-3">
                           <button type="submit" class="btn btn-success">Ödeme Yap</button>
                       </div>
                   </div>
               </div>
            }
        </div>
        <div class="col-md-4"></div>
    </div>
</div>

